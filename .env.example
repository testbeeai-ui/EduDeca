# Same Supabase Auth project as Edublast Web/.env
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local app URL (EduDeca runs on 3001)
NEXT_PUBLIC_EDUDECA_APP_URL=http://localhost:3001

# EduBlast origin for Mock Test set handoff (live site; localhost:3000 only for local Web)
NEXT_PUBLIC_EDUBLAST_APP_URL=https://www.edublast.in

# Same SMTP as Web/.env for invite/welcome email
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM_NAME=
EMAIL_ADMIN=
EMAIL_DAILY_SEND_CAP=
EDUDECA_INTERNAL_API_SECRET=
